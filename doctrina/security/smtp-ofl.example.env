# Plantilla para laboratorio local: OFL.cl. No contiene credenciales.
# Correo alojado en cPanel: consultar 'Email Accounts > Connect Devices' para host y puerto exactos.
# El host SMTP no se deduce automáticamente del dominio; confirmar certificado TLS.
# Crear una casilla real antes de usar SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@ofl.cl
SMTP_USER=
# En cPanel el usuario SMTP suele ser la dirección completa del buzón.
# Verificar SPF, DKIM y DMARC en Email Deliverability / Zone Editor.
# SMTP_PASSWORD debe inyectarse como secreto; nunca subirlo a GitHub.
RECOVERY_PUBLIC_ORIGIN=https://ofl.cl
# Solo pruebas locales hasta aprobación explícita de producción.
RECOVERY_MODE=local
