{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron-recordatorios",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron-calendario",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-calendario-invierno",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/admin-doctrina.js": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/unpdf/dist/**,config/memoria-agente.json}"
    },
    "api/cron-recordatorios.js": {
      "maxDuration": 300
    },
    "api/admin-asignaciones.js": {
      "maxDuration": 300
    },
    "api/cron-calendario.js": {
      "maxDuration": 300
    },
    "api/cron-calendario-invierno.js": {
      "maxDuration": 300
    },
    "api/admin-orador.js": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/unpdf/dist/**,config/orador.json,config/memoria-agente.json}"
    },
    "api/admin-usuarios.js": {
      "maxDuration": 30
    },
    "api/admin-trabajos.js": {
      "maxDuration": 120,
      "includeFiles": "node_modules/unpdf/dist/**"
    }
  },
  "buildCommand": "node scripts/verificar-groq.mjs && node scripts/verificar-orador.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/admin-informes",
      "destination": "/api/admin-usuarios?operacion=informes"
    },
    {
      "source": "/api/admin-roles",
      "destination": "/api/admin-usuarios?operacion=roles"
    }
  ]
}
